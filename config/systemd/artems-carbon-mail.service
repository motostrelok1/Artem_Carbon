[Unit]
Description=Artem Carbon buyer email outbox processor
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=artems-carbon
Group=artems-carbon
WorkingDirectory=/opt/artems-carbon/server
EnvironmentFile=/opt/artems-carbon/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/artems-carbon/server/src/mail-worker.js --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/artems-carbon/server
UMask=0077
TimeoutStartSec=60
