# Never commit real secrets. Fill these on a secured server only.
DATABASE_URL=postgres://artems:CHANGE_ME@127.0.0.1:5432/artems_carbon
PORT=3002
PUBLIC_SITE_URL=https://artemcarbon.ru
PUBLIC_BASE_PATH=/
API_PUBLIC_URL=https://api.artemcarbon.ru
# Enable ONLY after legal/fiscal review and test terminal setup.
PAYMENTS_ENABLED=false
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Fiscalization with CloudKassir: connect the cash register to THIS
# T-Bank terminal in T-Business -> Internet acquiring -> Shops -> Online cash register.
# CloudKassir Public ID and API password belong in the BANK CABINET, not this .env.
# Sending Receipt in /v2/Init does not itself mean the KKT is connected or live.
# Confirm seller taxation, VAT, FFD 1.2 and payment/item signs with accountant and provider.
# Never enable real checkout before a bank+CloudKassir receipt test.
# Supply valid taxation/receipt details per your real fiscalization scheme before enabling.
TBANK_TAXATION=
TBANK_ITEM_TAX=
# Separate server authentication, never the browser demo code 666666.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Transactional messages via the customer's mailbox. Default off.
EMAIL_ENABLED=false
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Carbonsuperb@bk.ru
SMTP_PASSWORD=
SMTP_FROM=ARTEMS CARBON <Carbonsuperb@bk.ru>
